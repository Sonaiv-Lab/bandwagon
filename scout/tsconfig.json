{
  "extends": "../tsconfig.json",
  "include": [
    "./resources/**/*",
    "./shared/**/*",
    "./services/**/*",
    "./domains/**/*"
  ],
  "compilerOptions": {
    "baseUrl": "../",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "outDir": "dist",
    "paths": {
      "#scout/dugout/package.json": ["./scout/services/dugout/package.json"],
      "#scout/lineup/package.json": ["./scout/services/lineup/package.json"],
      "#scout/runner/package.json": ["./scout/services/runner/package.json"],
      "#resources/*": ["./scout/resources/*"],
      "#domains/*": ["./scout/domains/*"],
      "#shared/*": ["./scout/shared/*"],
      "@bandwagon/shared/*": ["./shared/*"]
    }
  }
}
