{
  "name": "@bandwagon/scout",
  "project_name": "scout",
  "version": "0.0.1",
  "description": "The data resource of bandwagon app",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build:lineup": "tsup-node ./services/lineup/main.ts --outDir ./dist/lineup",
    "build:runner": "tsup-node ./services/runner/main.ts  --outDir ./dist/runner",
    "build:resource-script": "tsup-node ./shared/resource/generate.ts --outDir ./dist/resource",
    "build:scripts": "tsup-node ./scripts/*.ts --outDir dist/scripts",
    "build": "rm -rf ./dist && pnpm build:lineup && pnpm build:runner && pnpm build:scripts",
    "start:dev:lineup": "NODE_ENV=dev tsx --tsconfig ./tsconfig.json ./services/lineup/main.ts ",
    "start:dev:runner": "NODE_ENV=dev tsx --tsconfig ./tsconfig.json ./services/runner/main.ts ",
    "start:builded:lineup": "node ./dist/lineup/main.mjs",
    "start:builded:runner": "node ./dist/runner/main.mjs",
    "pre-playwright": "pnpm exec playwright install-deps chromium && pnpm exec playwright install chromium",
    "start:docker:lineup": "pnpm scripts:secret && pnpm start:builded:lineup",
    "start:docker:runner": "pnpm scripts:secret && pnpm start:builded:runner",
    "ts-check": "tsc --project ./tsconfig.json --noEmit",
    "node": "tsx --tsconfig ./tsconfig.json",
    "script:resource-generate": "pnpm build:resource-script && node ./dist/resource/generate.mjs",
    "redis:start": "redis-server $(brew --prefix)/etc/redis.conf",
    "build:docker": "./scripts/docker-build.sh",
    "scripts:secret": "node ./dist/scripts/fetchEnv.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@bandwagon/shared": "workspace:*",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/logging-winston": "^6.0.0",
    "@google-cloud/secret-manager": "^6.0.1",
    "@hono/node-server": "1.19.1",
    "bullmq": "^5.58.0",
    "cron": "^4.3.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.2.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.7.8",
    "ioredis": "^5.7.0",
    "luxon": "^3.6.1",
    "playwright": "^1.51.1",
    "undici": "^7.8.0",
    "winston": "^3.17.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.1",
    "@playwright/test": "^1.51.1",
    "@types/luxon": "^3.6.1",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "tsup": "^8.4.0",
    "typescript": "5.0.4"
  }
}
