{
  "name": "@bandwagon/piggyback",
  "project_name": "piggyback",
  "version": "0.0.2",
  "description": "The data resource of bandwagon app",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build:node": "tsup-node ./src/app.ts",
    "build:scripts": "tsup-node ./scripts/*.ts --outDir dist/scripts",
    "build": "rm -rf ./dist && pnpm build:node && pnpm build:scripts",
    "start:dev": "NODE_ENV=dev tsx --tsconfig ./tsconfig.json ./src/app.ts ",
    "start:builded": "node ./dist/app.mjs",
    "pre-playwright": "pnpm exec playwright install-deps chromium && pnpm exec playwright install chromium",
    "start:docker": "pnpm scripts:secret && pnpm start:builded",
    "dev": "pnpm start:dev",
    "dev:builded": "pnpm build:node && pnpm run start:builded",
    "ts-check": "tsc --project ./tsconfig.json --noEmit",
    "node": "tsx --tsconfig ./tsconfig.json",
    "scripts:secret": "node ./dist/scripts/fetchEnv.mjs",
    "scripts:secret:local": "NODE_ENV=dev node ./dist/scripts/fetchEnv.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@bandwagon/shared": "workspace:*",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/logging-winston": "^6.0.0",
    "@google-cloud/secret-manager": "^6.0.1",
    "@hono/node-server": "1.19.1",
    "commander": "^13.1.0",
    "cron": "^4.3.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.2.0",
    "google-auth-library": "^9.15.1",
    "hono": "4.7.8",
    "luxon": "^3.6.1",
    "microdiff": "^1.5.0",
    "object-to-formdata": "^4.5.1",
    "playwright": "^1.51.1",
    "undici": "^7.8.0",
    "winston": "^3.17.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.41.0",
    "@playwright/test": "^1.51.1",
    "@types/luxon": "^3.6.1",
    "tsup": "^8.4.0"
  }
}
