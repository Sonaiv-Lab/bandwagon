{
  "name": "@bandwagon/piggyback",
  "version": "0.0.1",
  "description": "The data resource of bandwagon app",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build:node": "rm -rf ./dist && tsup-node ./src/app.ts",
    "build": "pnpm build:node",
    "docker": "echo \"todo\"",
    "start:dev": "tsx --tsconfig ./tsconfig.json ./src/app.ts ",
    "start:builded": "node ./dist/app.mjs",
    "pre-playwright": "pnpm exec playwright install-deps chromium && pnpm exec playwright install chromium",
    "start:docker": "pnpm run pre-playwright && pnpm start:builded",
    "dev": "pnpm start:dev",
    "dev:builded": "pnpm build:node && pnpm run start:builded",
    "ts-check": "tsc --project ./tsconfig.json --noEmit",
    "node": "tsx --tsconfig ./tsconfig.json",
    "secret": "pnpm run node -- ./scripts/fetchEnv.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@bandwagon/utils": "workspace:*",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/secret-manager": "^6.0.1",
    "cron": "^4.3.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.2.0",
    "luxon": "^3.6.1",
    "microdiff": "^1.5.0",
    "object-to-formdata": "^4.5.1",
    "playwright": "^1.51.1",
    "undici": "^7.8.0",
    "zod": "^3.24.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.41.0",
    "@playwright/test": "^1.51.1",
    "@types/luxon": "^3.6.2",
    "tsup": "^8.4.0"
  }
}
