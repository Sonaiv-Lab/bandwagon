{
  "extends": "../tsconfig.json",
  "files": ["./src/app.ts"],
  "include": ["src/**/*", "scripts/**/*"],
  "compilerOptions": {
    "baseUrl": "../",
    "strict": true,
    "strictNullChecks": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "outDir": "dist",
    "paths": {
      "#/package.json": ["./piggyback/package.json"],
      "#/*": ["./piggyback/src/*"]
    }
  }
}
