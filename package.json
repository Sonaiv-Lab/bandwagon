{
  "name": "bandwagon",
  "version": "0.0.1",
  "description": "App for the taiwan baseball bandwagon fan",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "run:piggyback": "pnpm --filter @bandwagon/piggyback dev",
    "docker:build:piggyback": "docker build . --target piggyback --tag bandwagon/piggyback:latest",
    "docker:run-local:piggyback": "docker run --env NODE_ENV=dev -e DEPLOY_ENV=local -e RUNTIME_ENVIRONMENT=node -v ./.cert:/.cert bandwagon/piggyback"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3"
  }
}
